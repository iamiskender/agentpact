# AgentPact Agent Scripts — copy to agents/.env and fill in values
# Never commit .env to version control

# ── Network selection ─────────────────────────────────────────────────────────
# "testnet" (default) or "mainnet"
# On mainnet, real USDC is used. Only switch after independent review and testing.
NETWORK=testnet

# ── RPC and chain (auto-defaulted from NETWORK; override only if needed) ──────
# Testnet:  https://rpc.testnet.arc.io  / chainId 5042002
# Mainnet:  https://rpc.mainnet.arc.io  / chainId 5042
# RPC_URL=
# CHAIN_ID=

# ── Private key for this agent wallet (with or without 0x prefix) ─────────────
PRIVATE_KEY=0x...your_private_key_here...

# ── Deployed AgentPact contract address ───────────────────────────────────────
# Testnet (pre-deployed):
CONTRACT_ADDRESS=0x1c107518808eb351a32f02a08c6ecf154db4997e
# Mainnet (fill in after you deploy yourself):
# CONTRACT_ADDRESS=0x...your_mainnet_contract_address...

# ── USDC ERC-20 address (same on both Arc Testnet and Arc Mainnet) ─────────────
USDC_ADDRESS=0x3600000000000000000000000000000000000000

# ── Client agent config ───────────────────────────────────────────────────────
# The provider this client will hire
PROVIDER_ADDRESS=0x...provider_wallet_address...

# The arbiter to use for disputes
ARBITER_ADDRESS=0x...arbiter_wallet_address...

# Job amount in USDC (e.g. "5.00")
JOB_AMOUNT_USDC=5.00

# Delivery deadline in seconds from now
DELIVERY_DEADLINE_SECS=3600

# Review period in seconds (min 60, max 2592000)
REVIEW_PERIOD_SECS=3600

# Job description (hashed to specHash onchain)
JOB_SPEC=Produce a 200-word summary of the latest Arc block activity.

# ── Provider agent job-acceptance policy ─────────────────────────────────────

# Comma-separated list of arbiter addresses the provider trusts (case-insensitive).
# REQUIRED — the agent refuses to start if this is empty or missing.
TRUSTED_ARBITERS=

# Maximum review period the provider will accept, in seconds (default: 86400 = 24 h).
# Jobs with a longer review period are skipped.
MAX_REVIEW_SECONDS=86400

# Minimum job amount the provider will work for, in USDC (e.g. "0.01" or "5.00").
# Jobs below this amount are skipped.
MIN_AMOUNT_USDC=0.01

# Minimum seconds that must remain before the delivery deadline when the
# JobCreated event is seen. Jobs with less time left are skipped.
MIN_WORK_SECONDS=60
